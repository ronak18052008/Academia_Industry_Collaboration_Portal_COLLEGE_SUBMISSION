# REQUIRED in production
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=production
FLASK_DEBUG=0

# PostgreSQL in production. Render provides this automatically if linked to the database.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# AI
GEMINI_API_KEY=AIzaSyBst04p14TYMvM_59UYUTutQ3eQgJocKQw
GEMINI_MODEL=gemini-2.5-flash

# Uploads: set this to a persistent mounted disk path if your host provides one.
# Example on a Linux persistent disk: /var/data/uploads
UPLOAD_FOLDER=static/uploads

# OTP settings (sign-up verification is currently disabled in the supplied project)
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
OTP_DEMO_MODE=true
